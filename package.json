{
  "name": "naota-zalo",
  "version": "1.9.0",
  "author": "Hoang Ngoc Vuong (https://vuong.ai)",
  "description": "Zalo CLI and MCP server used by NAOTA: QR sign-in, multi-account, read and send messages, group notes, reminders and polls.",
  "type": "module",
  "bin": {
    "naota-zalo": "src/index.js",
    "zalo-agent": "src/index.js"
  },
  "main": "./src/index.js",
  "files": [
    "src/index.js",
    "src/commands",
    "src/core",
    "src/mcp",
    "src/utils",
    "!src/**/*.test.js",
    "LICENSE",
    "DISCLAIMER.md"
  ],
  "scripts": {
    "test": "node --test src/*.test.js src/**/*.test.js",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vuongtex/naota-zalo"
  },
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "chalk": "^5.3.0",
    "commander": "^14.0.3",
    "express": "^5.2.1",
    "https-proxy-agent": "^8.0.0",
    "node-fetch": "^3.3.0",
    "undici": "^7.24.6",
    "zca-js": "^2.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "eslint": "^10.0.3",
    "prettier": "^3.8.1"
  }
}
